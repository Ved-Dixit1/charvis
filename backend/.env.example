# Database configuration (Defaults to local SQLite sqlite:///./charvis.db if empty)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/charvis

# Hugging Face Configuration
HF_TOKEN=your_hugging_face_token_here
# Local cache directory for model downloads (Defaults to ~/.cache/huggingface if empty)
LOCAL_CACHE_DIR=

# LLM Provider Configuration for DAG Generation
# Can be Together AI, DeepInfra, OpenAI, or any OpenAI-compatible API
OPENAI_API_KEY=your_llm_provider_key_here
OPENAI_API_BASE=https://api.openai.com/v1
# Default model to use for pipeline generation
LLM_MODEL=gpt-4o-mini

# Server Execution Settings
PORT=8000
HOST=0.0.0.0
